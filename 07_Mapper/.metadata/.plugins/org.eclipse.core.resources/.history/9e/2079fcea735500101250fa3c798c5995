package egovframework.example.cmmn.interceptor;



import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;

import org.springframework.web.servlet.handler.HandlerInterceptorAdapter;


public class AuthenticInterceptor extends HandlerInterceptorAdapter{

	//우리회원인지 판단해서(세션에 있는지) 아니면 로그인 페이지로 강제이동
		//맞으면 해당메뉴 사용 가능
		//preHandle 오버라이딩
	    //용어: request (jsp->컨트롤러로 정보 전송)
        //    response(컨트롤러 ->jsp정보 전송)	
	
	@Override
	public boolean preHandle(HttpServletRequest request, HttpServletResponse response, Object handler)
			throws Exception {
		//  1)세션 가져오기
		// 사용법:request.getSession(옵션) false (세션잉 없으면 만들지 않음)
		HttpSession session = request.getSession(false);
		//  2)세션에 memberVO 가 없으면 강제이동(로그인 페이지)
		if (session == null || session.getAttribute("memberVO") == null) {
			
			response.sendRedirect("/login.do");   //로그인 강제이동
			return false;
		}
		return true;   //통과
	}

	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
}
