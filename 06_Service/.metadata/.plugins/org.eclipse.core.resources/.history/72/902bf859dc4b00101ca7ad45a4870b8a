
<%@page import="java.util.Date"%>
<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Insert title here</title>
<!-- 부트스트랩 css -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
<link rel="stylesheet" href="/css/00_style.css">
</head>
<body>
   <jsp:include page="/common/header.jsp"></jsp:include>
   <!-- 홈: JSP 의 추가 사용법 배우기 -->
   <div class="page mt5">
      <h2>JSP 추가 사용법</h2>
      
      <h2>1. c 라이브러리 함수들 소개</h2>
      <!-- 변수의 생성/소멸 주기
         page       : 변수가 현재 JSP 페이지에서만 유효함
         application: 전체프로그램 종료시까지 변수가 유효함(전역 변수)  
         session    : 로그인할때 사용, 로그인/로그아웃까지 사용(유효)(기분 30분)
         request    : 화면에서 요청을 보내고 컨트롤러에서 응답할때까지 유효
       -->
      <!-- JSP 주석: ctrl + shift + / , 블럭지정 -->
      <%-- 사용법: <c:set var="변수명" value="값" scope="page"> --%>
      <c:set var="num" value="10" scope="page"></c:set>
      <p>${num}</p>
      <c:set var="num2" value="10" scope="page"></c:set>
      <c:set var="total" value="${num+num2}" scope="page"></c:set>
      <p>${total}</p>
      
      <!-- 2) 문자열을 구분자로 구분하여 화면에 표시하는 함수 -->
<%--    <c:forTokens items="글자들" delims="구분값" var="변수">
         <p>${변수}</p>
      </c:forTokens>    --%>   
      <c:forTokens items="1/2/3" delims="/" var="a">
         <p>${a}</p>
      </c:forTokens>
      <br>
      
      <h3>3) not empty: 조건문</h3>
      <c:set var="num3" value=""></c:set>
      <!-- not empty: 값이 있으면 참(true) -->
      <c:if test="${not empty num3}">
         <p>값</p>
      </c:if>
      <!-- empty: 값이 없으면 참(true) -->
      <c:if test="${empty num3}">
         <p>값2</p>
      </c:if>
      
      <h3>4) 페이지 조각 끼워넣기: 머리말, 꼬리말 </h3>
      <%-- <jsp:include page="다른JSP파일"></jsp:include> --%>
      <jsp:include page="/common/footer.jsp"></jsp:include>
      
      <h3>5) URL 페이지 이동 </h3>
      <c:url value="http://www.naver.com" var="naver"></c:url>
      <h2><a href="${naver}">네이버</a></h2>
      <br>
      
      <h3>2. fn 라이브러리 사용법</h3>
      <c:set var="a" value="안녕 홍길동"></c:set>
      <c:set var="b" value="홍길동"></c:set>
      
      <h3>1) fn:contains(글자들, 글자1개)</h3>
      <!-- 글자들에 글자가 있으면 참(true) -->
      <p>${fn:contains(a,b)}</p>
      
      <h3>2) fn:indexOf(글자들, 글자1개)</h3>
      <!-- 글자들에 글자가 있는 위치를 화면에 표시: 0부터 시작(인덱스번호) -->
      <p>${fn:indexOf(a,"홍길동")}</p>
      
      <h3>3) fn:length(변수)</h3>
      <!-- 글자들의 개수 -->
      <p>${fn:length(a)}</p>
      
            <h3>4) fn:split()</h3>
      <c:set value="${fn:split(a,' ')}" var="b"></c:set>
      <p>${b[0]}</p>
      <p>${b[1]}</p>
      
      <!--JSP 버전업: 과거코딩(스크림틀릿) VS현재코딩(추천:jstl,el 표현식)  -->
      <!-- 과거: 스크립틀릿 코딩 -->
    <%
         /* 현재 날짜 가져오기   Date date =new java.util.Date();*/
          Date date=new java.util.Date();
      %>
      <p><%=date%></p> 
      
      
      <h3>4. fmt 라이브러리</h3>
      <!-- 숫자를 통화처럼 표시하기:3,000원  -->
      <c:set var="a" value="1234"></c:set>
      <p></p>
      
   </div>
   
   <jsp:include page="/common/footer.jsp"></jsp:include>
</body>
</html>


