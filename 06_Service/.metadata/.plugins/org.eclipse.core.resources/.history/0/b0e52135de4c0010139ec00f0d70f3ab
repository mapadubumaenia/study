<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!-- 반복문/조건문 때문에 사용 -->
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Insert title here</title>
<!-- 부트스트랩 css -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
<link rel="stylesheet" href="/css/00_style.css">
</head>
<body>
   <!-- 머리말 -->
<jsp:include page="/common/header.jsp"></jsp:include>      
   <!-- 본문  -->
<form id="listForm" name="listForm" method="get">
    <!-- eno 값 -->
    <input type="text" 
           id="eno" 
           name="eno" 
           >
   <div class="page mt5">
       <!-- 부트스트랩 테마: 검색어: -->
      <div class="input-group mb-3">
        <input type="text" 
               class="form-control" 
               id="searchKeyword"
               name="searchKeyword"
               placeholder="사원명 입력" >
        <button class="btn btn-primary" 
                type="button"
                onclick="fn_egov_selectList()" 
                >Button</button>
      </div>         
      
      <!-- 부트스트랩 테마: 테이블, 여기 -->
      <table class="table">
        <thead>
          <tr>
            <th scope="col">eno</th>
            <th scope="col">ename</th>
            <th scope="col">job</th>
            <th scope="col">manager</th>
          </tr>
        </thead>
        <tbody>
        <!-- 반복문 -->
        <c:forEach var="data" items="${list}">
          <tr>
            <th scope="row">
               <a href="javascript:fn_select('<c:out value="${data.eno}"/>')">   
                  <c:out value="${data.eno}"></c:out> 
               </a>
             </th>
            <td><c:out value="${data.ename}"></c:out></td>
            <td><c:out value="${data.job}"></c:out></td>
            <td><c:out value="${data.manager}"></c:out></td>
          </tr>        
        </c:forEach>

        </tbody>
      </table>


      <!-- 부트스트랩 테마: 버튼 -->
      <div class="tcenter">
         <a href="javascript:fn_addView()"
                 class="btn btn-primary"
                 >추가</a>
      </div>
   </div>

</form>
<!-- jquery cdn -->
<script src="https://code.jquery.com/jquery-3.1.0.js"></script>

<script type="text/javascript">
   /* 전체조회 */
   function fn_egov_selectList() {
      /* action:/emp/emp.do 컨트롤러 메소드에 검색어 전송 */
      $("#listForm").attr("action","<c:out value='/emp/emp.do' />")
                    .submit(); // 이때 데이터가 전송됨
   }
   /* jsp: add_emp.jsp (emp 추가)
      url: /emp/addition.do
         
      alert("되나?")-> 추가
   */
   function fn_addView() {
        /* /emp/addition.do 실행해서 추가페이지 열기 */
        $("#listForm").attr("action","<c:out value='/emp/addition.do' />")
                    .submit();
   }
   /* 수정 페이지 열기: 컨트롤러 필요 */
   function fn_select(eno) {
      $("#eno").val(eno);
        $("#listForm").attr("action","<c:out value='/emp/edition.do' />")
         .submit();      
   }

</script>
   <!-- 꼬리말 -->
<jsp:include page="/common/footer.jsp"></jsp:include>
</body>
</html>