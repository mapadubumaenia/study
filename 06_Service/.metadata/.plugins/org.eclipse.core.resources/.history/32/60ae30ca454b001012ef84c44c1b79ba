<jsp:include page="/common/header.jsp"></jsp:include>   
       <!-- jsp 추가사용법 배우기 -->
       <div class="page mt5">
           <h2>JSP추가 사용법</h2>
           <%-- 사용법: <c:set var="변수명" value="값" scope="page"></c:set> --%>
           <h2>1.c라이브러리 함수들 소개</h2> 
           <c:set var="num" value="10" scope="page"></c:set>
           <p>${num}</p>
            <c:set var="num2" value="10" scope="page"></c:set>
            <c:set var="total" value="${num+num2}" scope="page"></c:set>
            <p>${total}</p>
       </div>
       
